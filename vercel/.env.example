# Copy to .env.local for local dev. Never commit real values.

# Anthropic (primary LLM interviewer + structured feedback)
ANTHROPIC_API_KEY=

# OpenAI (fallback — used automatically if Anthropic fails before sending anything)
OPENAI_API_KEY=

# Supabase (service role — server-side only, never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same Supabase project's anon/public values, used only to verify client JWTs
SUPABASE_JWT_SECRET=
